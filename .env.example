# VIGIL environment — copy to .env (bootstrap.sh does this automatically) and edit.
#   cp .env.example .env && chmod 600 .env
# Consumed by docker-compose.yml and the wrapper scripts. NO secrets are required
# to bring the stack up; the commented lines are optional overrides. .env is
# gitignored — never commit it.

# --- Qdrant (vector store) ---------------------------------------------------
# Pin a specific tag for reproducible/production deploys (recommended over :latest).
# QDRANT_VERSION=latest

# --- Neo4j (knowledge graph; `--profile graph`) ------------------------------
# Format: user/password. CHANGE THIS before exposing the graph to anything.
# NEO4J_AUTH=neo4j/change-me

# --- OpenTelemetry collector (`--profile observability`) ---------------------
# OTEL_VERSION=latest

# --- strix (codebase / target agent body) ------------------------------------
# After `make strix` (or `docker compose --profile strix build strix-sandbox`),
# point strix at the locally-built Kali sandbox so nothing is pulled at run time:
# STRIX_IMAGE=vigil/strix-sandbox:local

# --- Anthropic / Claude (only if you run LLM-backed reasoning) ----------------
# The engine + agents use Claude. Provide a key ONLY if you drive live reasoning;
# it is read from the environment, never written to the spine or logged.
# ANTHROPIC_API_KEY=

# --- SIGIL (sovereign core) --------------------------------------------------
# Relocate the data root (default ~/.sigil). Usually leave unset.
# SIGIL_HOME=/home/youruser/.sigil
# Use a Qdrant SERVER (set automatically by bootstrap when compose Qdrant is up);
# leave unset to use SIGIL's embedded local vector store.
# SIGIL_QDRANT_URL=http://127.0.0.1:6333
