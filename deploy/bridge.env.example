# SIGIL systemd EnvironmentFile — copy to ~/.sigil/bridge.env and edit.
# =====================================================================
#   cp deploy/bridge.env.example ~/.sigil/bridge.env
#   chmod 600 ~/.sigil/bridge.env          # may hold override secrets later
#
# Consumed by the sigil-bridge@.service and sigil-consolidate.service units
# (EnvironmentFile=). Plain KEY=VALUE, one per line, NO quoting, NO `export`.
# systemd parses this file, not SIGIL's own sigil.env reader — keep them
# separate. Anything you set here also overrides SIGIL's built-in defaults.

# --- data root (defaults to ~/.sigil; only set to relocate the spine) -------
# SIGIL_HOME=/home/youruser/.sigil

# --- bridge bind port (the ADDRESS is the systemd instance name, e.g.
#     sigil-bridge@10.13.13.1 → --addr 10.13.13.1). CLI default is 8734. ------
SIGIL_BRIDGE_PORT=8734

# --- log verbosity: DEBUG | INFO | WARNING | ERROR --------------------------
SIGIL_LOG_LEVEL=INFO

# --- external binaries (set explicitly for a robust, PATH-independent unit) --
# Rust WARDEN kernel — needed for the bridge's command relay. If unset, SIGIL
# discovers kernel/target/release/sigil-kernel relative to the installed package.
# SIGIL_KERNEL_BIN=/home/youruser/sigil/kernel/target/release/sigil-kernel
# claude CLI (only if you later run an LLM-backed consolidate provider).
# SIGIL_CLAUDE_BIN=/home/youruser/.local/bin/claude

# --- vector store: set ONLY if you run Qdrant as a server (README uses the
#     loopback Docker container). Leave unset for embedded/local mode. --------
# SIGIL_QDRANT_URL=http://127.0.0.1:6333
