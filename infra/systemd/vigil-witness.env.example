# VIGIL witness co-sign service — environment file (TRUTHENOVATION A3)
# =====================================================================
# Copy to ~/.config/vigil/witness.env and edit. Consumed by the templated
# systemd unit vigil-witness@.service. UNQUOTED values (systemd reads them
# literally; do not wrap in quotes).

# Bind address for THIS witness. Loopback (default) or a WireGuard/Tailscale/LAN
# address only — a public / 0.0.0.0 bind is refused by the server (bind_ok).
# For N witnesses reachable from a submit client on other hosts, bind each to
# your tunnel IP (e.g. 10.13.13.2) and firewall the port to the tunnel.
VIGIL_WITNESS_HOST=127.0.0.1

# This witness's persistent Ed25519 key file (JSON {key_id, public_key_b64,
# private_key_b64}). Minted 0600 on first run; the SAME public key every restart,
# so the verifier's out-of-band roster stays valid. The '%i' in the unit's default
# is the port, giving one key per instance; set an explicit path to name it.
#   VIGIL_WITNESS_KEY=%h/.config/vigil/witness-w0.key
#
# GENUINE INDEPENDENCE (the A3 residual): distinct keys are NOT distinct
# operators. For witnessing that resists equivocation, N witnesses must run on
# SEPARATE machines held by SEPARATE parties — a third party runs their own with
# their own key. A local N-witness deploy proves the MECHANISM, not independence.
VIGIL_WITNESS_KEY=%h/.config/vigil/witness.key
