# VIGIL continuous integrity verifier — optional config for vigil-integrity.service.
# Copy to ~/.config/vigil/integrity.env and edit. The unit runs with defaults even
# if this file is absent (EnvironmentFile=- makes it optional).

# The sovereign spine home to verify (holds spine.jsonl / head.json / floor.json).
# Default: ~/.sigil. If you change this, ALSO update ReadWritePaths in the .service.
# SIGIL_HOME=%h/.sigil

# --- thresholds (all optional; fail-closed defaults shown) ---------------------
# A signed head not refreshed within this many seconds is WARNed as idle (NOT failed —
# the structural stale-head check needs no clock). Default 86400 (24h).
# VIGIL_INTEGRITY_MAX_HEAD_AGE_S=86400

# Clock-skew tolerance in seconds: a record dated further in the future than this, or a
# supplied trusted reference clock diverging by more than this, is a FAIL. Default 300.
# VIGIL_INTEGRITY_MAX_CLOCK_SKEW_S=300

# Disk headroom under the spine home: below WARN → advisory, below CRIT → FAIL.
# VIGIL_INTEGRITY_MIN_DISK_WARN_BYTES=104857600   # 100 MiB
# VIGIL_INTEGRITY_MIN_DISK_CRIT_BYTES=10485760    # 10 MiB

# Dead-man: a heartbeat older than this (or absent) means the verifier stopped running,
# which `vigil doctor` / /readyz alarm on. Keep it > the timer cadence. Default 3600.
# VIGIL_INTEGRITY_MAX_HEARTBEAT_STALENESS_S=3600
