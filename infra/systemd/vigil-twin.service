# VIGIL STANDING TWIN — systemd USER service (oneshot)
# =====================================================================
# M4.5. Runs `crucible twin refresh --once`: ONE pure refresh cycle that
# re-projects the latest signed spine into a STORED, ADVISORY worldmodel
# snapshot (JSON) — the asset topology as of the current spine head, kept
# on disk for triage/dashboards without re-projecting on every read. The
# systemd timer (vigil-twin.timer) fires this on a cadence so the stored
# twin tracks the spine head over time.
#
# ADVISORY ONLY: the twin snapshot is never an oracle input and never mints
# a FACT — it is a convenience projection. The refresh sends NO traffic and
# reads only the local signed spine (fully offline), so this unit runs with
# the network namespace turned OFF (PrivateNetwork=yes) — the opposite of
# vigil-reprove, whose live re-drive needs egress.
#
# The engagement-specific arguments (which spine, output dir, optional
# footholds) live in an EnvironmentFile so this unit is reusable:
#
#     ~/.config/vigil/twin.env       (VIGIL_TWIN_ARGS=…  — see the example)
#
# Manual run / logs:
#     systemctl --user start vigil-twin.service
#     journalctl --user -u vigil-twin -e
#
# INSTALL (paired with the timer):
#   mkdir -p ~/.config/systemd/user ~/.config/vigil
#   cp infra/systemd/vigil-twin.{service,timer} ~/.config/systemd/user/
#   cp infra/systemd/vigil-twin.env.example      ~/.config/vigil/twin.env
#   $EDITOR ~/.config/vigil/twin.env             # set VIGIL_TWIN_ARGS + VIGIL_BASE_DIR
#   systemctl --user daemon-reload
#   systemctl --user enable --now vigil-twin.timer

[Unit]
Description=VIGIL standing twin (one cadence cycle: re-project the signed spine into a stored advisory worldmodel snapshot)
Documentation=file:%h/vigil/docs/CLI-REFERENCE.md

[Service]
Type=oneshot

# Engagement config: VIGIL_TWIN_ARGS (the refresh flags — --spine + --out + optional --source footholds) and
# VIGIL_BASE_DIR (the writable engagement home, used by ReadWritePaths below).
EnvironmentFile=%h/.config/vigil/twin.env
Environment=PYTHONUNBUFFERED=1

WorkingDirectory=%h/vigil
# The offense venv's CRUCIBLE console script (crucible = framework.v2.__main__:main). Adjust the path if your
# checkout or venv lives elsewhere. `refresh --once` is fixed here (the timer owns the cadence); VIGIL_TWIN_ARGS
# is word-split by systemd (leave it UNQUOTED in the env file) into the --spine/--out/--source flags.
ExecStart=%h/vigil/.venv-offense/bin/crucible twin refresh --once $VIGIL_TWIN_ARGS

# --- W8-1 (#467): heartbeat + staleness alarm ------------------------------
# Record that this unit RAN (and its SERVICE_RESULT) so `vigil alerts` (the vigil-alerts.timer monitor)
# can raise a staleness alarm if this unit/timer stops firing, or a failure alarm if a run fails.
# ExecStopPost runs on BOTH success and failure; systemd exports $SERVICE_RESULT into its environment.
# StateDirectory=vigil makes the heartbeat dir writable even under ProtectSystem=strict / PrivateNetwork.
# (vigil-twin.service is registered in integration/vigil_integration/unit_alerts.py::HA_UNITS, so the
# enumeration guard monitors it.)
StateDirectory=vigil
Environment=VIGIL_ALERT_STATE_DIR=%S/vigil/unit-heartbeats
ExecStopPost=%h/vigil/.venv-offense/bin/vigil unit-heartbeat %n

# --- hardening (same posture as vigil-reprove, PLUS PrivateNetwork) ---------
# It writes ONE advisory snapshot under the engagement base dir and reads only the local signed spine, so it
# needs write access to VIGIL_BASE_DIR and nothing else — AND no network at all. PrivateNetwork=yes is the
# honest posture for a fully offline job (and reinforces the never-liftable egress floor); this is the one
# deliberate difference from vigil-reprove, whose live re-drive requires egress.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=${VIGIL_BASE_DIR}
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# NOT set (would break it): ProtectHome (hides the checkout + base dir), MemoryDenyWriteExecute (native-lib
# safety).
