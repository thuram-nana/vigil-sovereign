# VIGIL posture re-proof — engagement config (copy to ~/.config/vigil/posture.env)
# VIGIL_POSTURE_ARGS is word-split by systemd — leave it UNQUOTED. Flags for
# `python -m vigil_integration.posture.reprove --cycles 1 $VIGIL_POSTURE_ARGS`:
#   --series-dir <dir>     where the anti-rollback posture attestation series is persisted (REQUIRED)
#   --engagement <name>    the engagement label bound into the identity attestation
VIGIL_POSTURE_ARGS=--series-dir %h/.local/share/vigil/posture-series --engagement my-engagement

# The writable engagement home (used by the unit's ReadWritePaths= hardening).
VIGIL_BASE_DIR=%h/.local/share/vigil
