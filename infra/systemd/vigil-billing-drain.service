# VIGIL SaaS money-IN drain — systemd USER service (oneshot, fired every 60s by its timer). OPT-IN.
# =====================================================================
# Front B (from the #69 re-grounding): inbound Flutterwave billing webhooks are spooled by the proxy's
# /webhooks/billing route (VIGIL_BILLING_WEBHOOK_SPOOL — HMAC-verified, INERT) and, until now, only drained when an
# operator ran `sigil billing-drain` by hand: a stall DELAYED every paid customer's credit grant. This unit runs ONE
# drain pass on a cadence, exactly like vigil-settle-drain / vigil-finding-drain do for their spools.
#
# The drain itself is unchanged and fail-closed (`sigil billing-drain`): it refuses unless
# VIGIL_BILLING_DRAIN_ENABLED=1, takes the verif-hash secret ONLY from VIGIL_BILLING_WEBHOOK_SECRET (never argv),
# refuses without a server-side transaction verifier (VIGIL_FLW_SECRET_KEY), re-verifies EVERY charge with the
# processor before the OWNER CATALOG decides the credit, and mints exactly once per transaction. A quarantined
# webhook (a paid charge that could not be minted) makes the pass exit non-zero, so this unit stays FAILED and
# the dead-man alarms until rejected/ is empty.
#
# NETWORK: deliberately NOT PrivateNetwork — the server-side re-verify is an HTTPS call to the payment
# processor (host-allowlisted in sigil.governor.flutterwave_egress).
#
# SECRETS (VIGIL_BILLING_WEBHOOK_SECRET, VIGIL_FLW_SECRET_KEY) — per GO-LIVE §9 inject them from your secret
# manager, never commit them and prefer not to rest them in plaintext.
# PREFERRED: systemd credentials, which the drain reads ITSELF from $CREDENTIALS_DIRECTORY/<NAME> (a credential
# wins over an env value of the same name), so a secret never enters the unit-wide environment. A drop-in
# (`systemctl --user edit vigil-billing-drain.service`), each file 0600 outside the repo:
#     [Service]
#     LoadCredential=VIGIL_FLW_SECRET_KEY:%h/.config/vigil/credstore/VIGIL_FLW_SECRET_KEY
#     LoadCredential=VIGIL_BILLING_WEBHOOK_SECRET:%h/.config/vigil/credstore/VIGIL_BILLING_WEBHOOK_SECRET
# (or LoadCredentialEncrypted= with a systemd-creds(1)-encrypted file, where your systemd supports it for user
# units — then nothing rests in plaintext). Leave those names OUT of the env file.
# The EnvironmentFile below (mode 0600) is the documented FALLBACK — see vigil-billing-drain.env.example.
# THE SPOOL is not named here: the drain DERIVES it — the proxy's own VIGIL_BILLING_WEBHOOK_SPOOL when that is
# set in the env file below, else the runbook path $SIGIL_HOME/billing-spool — so it follows a moved SIGIL_HOME
# instead of running "healthy" on an empty ~/.sigil directory and crediting nothing. If you moved SIGIL_HOME
# (GO-LIVE §2), set SIGIL_HOME in the env file below (the drain also mints onto the spine under it) and add it to
# ReadWritePaths; a drain whose SIGIL_HOME holds no owner identity (the move not carried here) REFUSES (FAILED).
# An explicit VIGIL_BILLING_SPOOL still wins, but the drain REFUSES (unit FAILED) one that contradicts
# VIGIL_BILLING_WEBHOOK_SPOOL, or that is ~/.sigil/billing-spool while SIGIL_HOME is elsewhere.
# ONE DRAINER: run THIS timer OR a manual `sigil billing-drain watch`, never both. It is enforced: each pass
# holds an exclusive lock (<spool>/working/.drain.lock). A pass that finds it held waits up to 120 s for the
# other pass to end; still held after that, it touches nothing and FAILS (the dead-man alarms on a stuck drainer).
#
# Manual run / logs:
#     systemctl --user start vigil-billing-drain.service
#     journalctl --user -u vigil-billing-drain -e
#
# INSTALL (paired with its timer):
#   cp infra/systemd/vigil-billing-drain.{service,timer} ~/.config/systemd/user/
#   install -m 600 infra/systemd/vigil-billing-drain.env.example ~/.config/vigil/billing-drain.env  # then edit
#   systemctl --user daemon-reload
#   systemctl --user enable --now vigil-billing-drain.timer

[Unit]
Description=VIGIL SaaS money-IN drain (one pass: billing webhook → processor re-verify → owner-signed credit mint)
Documentation=file:%h/vigil/docs/runbooks/AWS-DEPLOY.md

[Service]
Type=oneshot
Environment=PYTHONUNBUFFERED=1
# No spool path here (see THE SPOOL above). systemd expands %h in a unit directive, NEVER inside an
# EnvironmentFile value; the CLI refuses a relative / %-bearing spool (exit non-zero → a FAILED dead-man alarm,
# never a silent no-op).
EnvironmentFile=-%h/.config/vigil/billing-drain.env
WorkingDirectory=%h/.sigil
ExecStart=%h/.sigil/venv/bin/sigil billing-drain drain
# A pass is a handful of HTTPS re-verifies, each bounded at 15 s (a NET-2b deferral adds no wait: a parked webhook
# is retried on a LATER pass). One that hangs is killed (unit FAILED → the dead-man alarms) rather than holding the
# single-drainer lock forever; the next pass reclaims its in-flight claim (idempotent). Above the 120 s lock wait.
TimeoutStartSec=300

# --- heartbeat + staleness alarm (W8-1 pattern) ------------------------------
StateDirectory=vigil
Environment=VIGIL_ALERT_STATE_DIR=%S/vigil/unit-heartbeats
# The EnvironmentFile is unit-wide, so the heartbeat hook (a different venv, another codebase) would inherit every
# secret in it (the two payment secrets, and anything else an operator puts there). An ALLOW-list, not a
# strip-list: the hook runs with an EMPTY environment plus the three values it reads (systemd turns "$$" into "$";
# SERVICE_RESULT exists only in this hook's own environment, so the shell forwards it).
ExecStopPost=/bin/sh -c 'exec /usr/bin/env -i HOME="$$HOME" SERVICE_RESULT="$$SERVICE_RESULT" VIGIL_ALERT_STATE_DIR="$$VIGIL_ALERT_STATE_DIR" "$$0" unit-heartbeat "$$1"' %h/vigil/.venv-offense/bin/vigil %n

# --- hardening -------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=%h/.sigil
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# IMPORTANT: if the spool (or SIGIL_HOME) is outside ~/.sigil, ADD it to ReadWritePaths above.
