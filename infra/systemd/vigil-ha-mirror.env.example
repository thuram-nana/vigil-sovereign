# VIGIL HA passive mirror-sync config — copy to ~/.config/vigil/ha-mirror.env (chmod 600).
# =====================================================================
# Read by vigil-ha-mirror.service (which runs tools/ha/mirror-sync.sh delta ON THE PASSIVE).
# NOTHING secret is required here for the rsync DELTA (it copies files only). The one-time
# BULK seed is a manual step and reads SIGIL_BACKUP_PASSPHRASE from the environment, never argv.

# The rsync SOURCE: the ACTIVE writer's ~/.sigil. Either an ssh spec or a locally-mounted path.
# Trailing slash matters to rsync (copy the CONTENTS of ~/.sigil into the mirror dir).
VIGIL_ACTIVE_SIGIL=user@active-host:~/.sigil/

# The passive's mirror dir. MUST be a SEPARATE dir from the live ~/.sigil (the script refuses otherwise).
VIGIL_MIRROR_HOME=%h/.sigil-mirror

# OPTIONAL: a systemd --user unit whose "active" state also means "this host is a writer, not a passive".
# If set and active, mirror-sync.sh refuses to run (fail-closed). Leave empty on a pure passive.
VIGIL_WRITER_UNIT=

# OPTIONAL: sovereign CLI path (only needed for the manual `seed` mode's `sigil restore`).
# SIGIL_CMD=%h/vigil/.venv-sovereign/bin/sigil
