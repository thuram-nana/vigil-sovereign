# VIGIL SaaS findings-crossing drain — config for vigil-finding-drain.service
# Copy to ~/.config/vigil/finding-drain.env and fill in. The .service expands these with ${VAR}.
# =====================================================================

# Arm the staleness dead-man EARLY. Set this to 1 (in the vigil-alerts monitor's env, e.g.
# ~/.config/vigil/alerts.env) ONLY when you have enabled the timer AND provisioned the delegation below:
# it makes `vigil alerts` watch this unit fail-closed from BEFORE its first fire. You no longer have to
# remember it to stay safe, though — once the drain has fired once (a heartbeat exists on disk), the
# monitor watches it automatically (run-state coupling), so an ENABLED, firing drain is never silently
# unwatched. A host that never ran the drain (no flag AND no heartbeat) is not watched (no false ABSENT
# alarm). TEARDOWN: to deliberately turn the drain OFF, disable the timer AND remove its heartbeat
# ($XDG_STATE_HOME/vigil/unit-heartbeats/vigil-finding-drain.service.hb.json) so the dead-man stands down.
VIGIL_FINDING_DRAIN_ENABLED=1

# The finding spool directory (its incoming/ is drained). The offense side writes inert envelopes here.
VIGIL_FINDING_SPOOL=%h/.sigil/spool/findings

# The owner-signed OFFENSE_GOVERNANCE delegation JSON that authorizes FINDINGS. Provision this per
# deployment (it is the owner tie that makes a crossed finding trustworthy); the drain is fail-closed
# without it.
VIGIL_FINDING_GOV_DELEGATION=%h/.config/vigil/offense-governance-delegation.json

# The engagement scope this drain confines ingest to ("*" = any in-scope engagement the delegation covers;
# a cust_<hash> slug confines it to one tenant engagement).
VIGIL_FINDING_SCOPE=*

# OPTIONAL: to also cross DETECTION FACTs, provision an OFFENSE_SPINE delegation and add
#   --spine-delegation ${VIGIL_FINDING_SPINE_DELEGATION}
# to the unit's ExecStart, then set:
# VIGIL_FINDING_SPINE_DELEGATION=%h/.config/vigil/offense-spine-delegation.json

# OPTIONAL: set SIGIL_HOME if the sovereign spine home is not the default (then add it to the unit's
# ReadWritePaths).
# SIGIL_HOME=%h/.sigil
