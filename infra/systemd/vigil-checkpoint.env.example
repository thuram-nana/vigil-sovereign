# VIGIL scheduled off-box witnessed-checkpoint emitter — environment file (W7-5, #463)
# =====================================================================
# Copy to ~/.config/vigil/checkpoint.env and edit. Consumed by vigil-checkpoint.service. UNQUOTED values
# (systemd reads them literally; do not wrap in quotes).

# The offense attestation-log directory holding head.json + highwater.json (what gets witnessed).
VIGIL_CHECKPOINT_LOG_DIR=%h/.vigil-live/attestation-log

# The offense engine home holding the sealed offense GOVERNANCE key that co-signs the checkpoint (FATAL-2:
# the offense side NEVER holds an owner key; the anchor is governance-signed).
VIGIL_CHECKPOINT_BASE_DIR=%h/.vigil-live

# The engagement slug the witnessed checkpoint is bound to (must match the store's scope).
VIGIL_CHECKPOINT_SCOPE=loopback

# ┌───────────────────────────────────────────────────────────────────┐
# │  OFF-BOX. This is the whole point. A copy kept on the active host  │
# │  is rolled back WITH the spine and is NOT an anchor. Point this at │
# │  a mounted second disk / USB / remote-or-tunnel mount, and add its │
# │  directory to ReadWritePaths in vigil-checkpoint.service.          │
# └───────────────────────────────────────────────────────────────────┘
VIGIL_CHECKPOINT_RETAIN=%h/.config/vigil/checkpoint.witnessed.json

# Freshness bounds the anti-rollback verify + HA failover guard enforce on this anchor (seconds). WARN is the
# "the emitter looks unhealthy" alert; REFUSE is the fail-closed floor (a promotion off an anchor older than
# this is refused). Keep the timer cadence WELL under WARN. Defaults: 21600 (6h) warn / 86400 (24h) refuse.
# VIGIL_ANCHOR_WARN_AFTER_S=21600
# VIGIL_ANCHOR_REFUSE_AFTER_S=86400
