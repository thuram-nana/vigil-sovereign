# VIGIL staleness-alarm monitor timer — fires the monitor on a cadence.
# =====================================================================
# W8-1 (#467). THIS is the "continuous" in continuous alerting: it fires
# vigil-alerts.service on a schedule, so every scheduled unit's heartbeat is
# re-checked and a stale/failed unit is alarmed WITHIN one cadence instead of
# sitting undetected until a human runs `journalctl`.
#
# Enable with:
#   systemctl --user enable --now vigil-alerts.timer
#   systemctl --user list-timers 'vigil-*'     # confirm next run
#
# CADENCE CHOICE: 10 minutes is tighter than every ALWAYS-ON unit's staleness bound
# (the shortest, the 15-minute HA mirror / integrity units, is ~23.5 minutes), so a
# stopped always-on unit is observed before its next legitimate run. The two OPT-IN
# SaaS drains run on a ~60s cadence (≈105s bound), well under this cadence — so a
# stopped drain is detected at this monitor's 10-minute granularity, not within 105s.
# That latency is acceptable: a stopped drain loses nothing (findings/completions
# queue durably in their spools and cross on restart), and a transient sub-10-minute
# hiccup self-recovers without a page. A deployment that wants prompter money-drain
# detection can lower this OnCalendar cadence (the read is cheap).
#
# DELIVERY DEAD-MAN: the monitor advances an alert-delivery heartbeat on every
# successful push. If THIS timer stops firing — or the push path stays down — that
# delivery heartbeat goes stale, which `vigil alerts --status` / a watchdog reads:
# the failure of the alerting path is itself observable, not silent.

[Unit]
Description=Cadence trigger for the VIGIL heartbeat staleness-alarm monitor
Documentation=file:%h/vigil/docs/OBSERVABILITY.md

[Timer]
# Every 10 minutes — tighter than the shortest monitored staleness bound (~23.5m).
OnCalendar=*-*-* *:00/10:15
# If the machine was asleep/off at the scheduled time, run once on the next wake.
Persistent=true
# Small smear so a fleet does not all fire at once.
RandomizedDelaySec=30
Unit=vigil-alerts.service

[Install]
WantedBy=timers.target
