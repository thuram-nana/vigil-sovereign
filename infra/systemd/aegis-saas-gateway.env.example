# /etc/aegis-saas/<instance>.env — chmod 600, owned by root (read by systemd before dropping to `aegis`).
AEGIS_SAAS_UPSTREAM=http://127.0.0.1:3000
AEGIS_SAAS_BIND=127.0.0.1
AEGIS_SAAS_PORT=8080
# observe (default) never blocks. `enforce` blocks ONLY with a BLOCK grant + VIGIL_AEGIS_SAAS_ENFORCE=1 + AEGIS_RESPOND.
AEGIS_SAAS_MODE=observe
AEGIS_SAAS_TENANT=org_xxxxxxxx
AEGIS_SAAS_HOST=app.example.com
AEGIS_SAAS_SPOOL_DIR=/var/lib/aegis-saas/<instance>/spool
# 0600 file owned by `aegis`, copied from the sovereign `sigil monitoring-secret` output path.
AEGIS_SAAS_SECRET_FILE=/etc/aegis-saas/<instance>.report.secret
# Read-only verify inputs (published by the sovereign provisioner):
VIGIL_MONITORING_PUBLISH_DIR=/var/lib/aegis-saas/monitoring_authority
VIGIL_AUTHORITY_ROOT_DIR=/var/lib/aegis-saas/authority-root
# Per-deployment pseudonymization secret (NOT the report secret):
AEGIS_GW_SECRET=change-me-random
# Leave OFF unless the flag-hold runbook says otherwise:
# VIGIL_AEGIS_SAAS_ENFORCE=1
