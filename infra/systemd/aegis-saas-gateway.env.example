# /etc/aegis-saas/<instance>.env — chmod 600, owned by root (read by systemd before dropping to the
# per-instance DynamicUser). AS-2j (R15): this file carries ONLY non-secret configuration. NO secrets here —
# the deployment (pseudonymization) secret and the report secret are delivered through LoadCredential= from
# 0600 files (see below), so neither ever lands in the gateway's environment / /proc/<pid>/environ.
# The aegis_unit_lint hardening lint FAILS if a secret is reintroduced into the unit's environment.
AEGIS_SAAS_UPSTREAM=http://127.0.0.1:3000
# NOTE: ingress is a UNIX SOCKET (/run/aegis-saas/<instance>/gw.sock, via --listen-unix + SO_PEERCRED) — there
# is no TCP bind, so AEGIS_SAAS_BIND / AEGIS_SAAS_PORT are gone. The ALB-only front connects to the socket.
# observe (default) never blocks. `enforce` blocks ONLY with a BLOCK grant + VIGIL_AEGIS_SAAS_ENFORCE=1 + AEGIS_RESPOND.
AEGIS_SAAS_MODE=observe
AEGIS_SAAS_TENANT=org_xxxxxxxx
AEGIS_SAAS_HOST=app.example.com
# Read-only verify inputs (published by the sovereign provisioner) are bind-mounted read-only by the unit at
# the fixed convention paths /var/lib/aegis-saas/{monitoring_authority,authority-root}; they are NOT configured here.
#
# SECRETS — provisioned as 0600 files that the unit's LoadCredential= loads into the credential store; the unit
# reads them from ${CREDENTIALS_DIRECTORY}, never the environment:
#   /etc/aegis-saas/<instance>.report.secret   the per-(org,host) REPORT secret (`sigil monitoring-secret` export)
#   /etc/aegis-saas/<instance>.gw.secret       the per-deployment PSEUDONYMIZATION secret (>=16 bytes, random)
# Leave hard blocking OFF unless the flag-hold runbook says otherwise:
# VIGIL_AEGIS_SAAS_ENFORCE=1
