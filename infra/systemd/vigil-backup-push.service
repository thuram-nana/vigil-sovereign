# VIGIL off-HOST backup PUSH — systemd USER service (oneshot, network-enabled)
# =====================================================================
# Claim 6 / Piece A (SUB-PART 3). The COMPANION to vigil-backup.service. Where the
# routine local backup runs AIR-GAPPED and writes to the same host's disk, THIS
# unit takes a two-plane backup AND replicates it OFF the host: `vigil backup
# --push ${VIGIL_PUSH_DEST}` copies the already-ENCRYPTED plane files (*.vglbk /
# *.sglbk) + MANIFEST.json to a configured transport destination after a
# successful backup, then VERIFIES the copy AT THE DESTINATION (re-reads the
# landed bytes — a remote `sha256sum` over rsync+ssh, or a byte-for-byte
# read-back — and refuses a truncated/corrupted/tampered copy, fail-closed:
# W7-4 #462). Only CIPHERTEXT is transported — no plaintext and no passphrase
# ever leave the host; the pushed copy is itself a valid restore source. A
# destination-integrity failure makes this unit fail, which the ExecStopPost
# heartbeat below turns into a W8-1 (#467) alert. The remote's own access
# control is the operator's responsibility.
#
# This unit therefore needs the NETWORK (PrivateNetwork=no) — the ONE deliberate
# difference from vigil-backup.service. It is kept SEPARATE so the routine backup
# stays air-gapped; enable this ONE only if you want automated off-host copies.
#
# Config lives in an EnvironmentFile (0600), reusing the backup passphrase:
#     ~/.config/vigil/backup-push.env
#       VIGIL_BACKUP_PASSPHRASE=…    (the ONLY key to the encrypted files; never on argv)
#       VIGIL_BASE_DIR=.vigil-live   (the offense engine home)
#       VIGIL_PUSH_DEST=…            (transport dest: a bare path / local:<path> for the local-directory
#                                     backend — a mounted remote FS, sshfs, or a removable disk — or
#                                     rsync:[user@]host:path / rsync://host/module/path for the real
#                                     rsync backend (over ssh or an rsync daemon). scp/object-store
#                                     backends slot in later.)
#
# Manual run / logs:
#     systemctl --user start vigil-backup-push.service
#     journalctl --user -u vigil-backup-push -e
#
# INSTALL (paired with its timer):
#   cp infra/systemd/vigil-backup-push.{service,timer} ~/.config/systemd/user/
#   cp infra/systemd/vigil-backup-push.env.example      ~/.config/vigil/backup-push.env
#   chmod 600 ~/.config/vigil/backup-push.env
#   $EDITOR ~/.config/vigil/backup-push.env             # set the passphrase + VIGIL_PUSH_DEST
#   systemctl --user daemon-reload
#   systemctl --user enable --now vigil-backup-push.timer

[Unit]
Description=VIGIL off-HOST backup push (two-plane backup + replicate ENCRYPTED files to a remote; ciphertext only)
Documentation=file:%h/vigil/docs/plain-english/07-signing-and-keys.md

[Service]
Type=oneshot

EnvironmentFile=%h/.config/vigil/backup-push.env
Environment=PYTHONUNBUFFERED=1

WorkingDirectory=%h/vigil
# Take a two-plane backup and replicate it off-host in one step. --prune keeps the local retention tidy; the
# push copies the encrypted parts + MANIFEST to VIGIL_PUSH_DEST. Adjust the checkout/venv path if it differs.
ExecStart=%h/vigil/.venv-offense/bin/vigil backup --out %h/vigil-backups --base-dir ${VIGIL_BASE_DIR} --push ${VIGIL_PUSH_DEST} --prune --keep-days 30 --keep-last 8

# --- W8-1 (#467): heartbeat + staleness alarm ------------------------------
# Record that this unit RAN (and its SERVICE_RESULT) so `vigil alerts` (the vigil-alerts.timer monitor)
# can raise a staleness alarm if this unit/timer stops firing, or a failure alarm if a run fails.
# ExecStopPost runs on BOTH success and failure; systemd exports $SERVICE_RESULT into its environment.
# StateDirectory=vigil makes the heartbeat dir writable even under ProtectSystem=strict / PrivateNetwork.
StateDirectory=vigil
Environment=VIGIL_ALERT_STATE_DIR=%S/vigil/unit-heartbeats
ExecStopPost=%h/vigil/.venv-offense/bin/vigil unit-heartbeat %n

# --- hardening -------------------------------------------------------------
# UNLIKE vigil-backup.service, the network is REQUIRED here (the push reaches a remote), so PrivateNetwork is
# NOT set. Everything else stays locked down; the transported bytes are already passphrase-encrypted.
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# NOT set: PrivateNetwork (the push needs egress to the remote) and ProtectHome (hides the checkout, the engine
# homes, ~/.sigil, and ~/vigil-backups). If VIGIL_PUSH_DEST is a mounted remote FS, ensure the mount is visible.
