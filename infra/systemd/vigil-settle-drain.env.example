# VIGIL SaaS settle-on-completion drain — config for vigil-settle-drain.service
# Copy to ~/.config/vigil/settle-drain.env and fill in. The .service expands these with ${VAR}.
# =====================================================================

# Arm the staleness dead-man EARLY. Set this to 1 (in the vigil-alerts monitor's env, e.g.
# ~/.config/vigil/alerts.env) ONLY when the timer is enabled AND the delegation below is provisioned: it
# makes `vigil alerts` watch this money drain fail-closed from BEFORE its first fire. You no longer have to
# remember it to stay safe, though — once the drain has fired once (a heartbeat exists on disk), the monitor
# watches it automatically (run-state coupling), so an ENABLED, firing settle drain is never silently
# unwatched (a stuck settle is money owed either way). A host that never ran it (no flag AND no heartbeat) is
# not watched (no false ABSENT alarm). TEARDOWN: to deliberately turn the drain OFF, disable the timer AND
# remove its heartbeat ($XDG_STATE_HOME/vigil/unit-heartbeats/vigil-settle-drain.service.hb.json).
VIGIL_SETTLE_DRAIN_ENABLED=1

# The settle spool directory (its incoming/ is drained). The offense worker writes signed completion signals here.
VIGIL_SETTLE_SPOOL=%h/.sigil/spool/settle

# The owner-signed OFFENSE_GOVERNANCE delegation JSON, scoped to the cust_ engagement slug this drain settles.
VIGIL_SETTLE_DELEGATION=%h/.config/vigil/offense-governance-delegation.json

# The cust_ engagement slug this drain is confined to (must match the delegation scope; "*" only if the
# delegation itself is wildcard-scoped).
VIGIL_SETTLE_SCOPE=*

# The credit-lease seam root — the published lease is READ and the settlement/tombstone WRITTEN here.
# If this is outside ~/.sigil, add it to the unit's ReadWritePaths.
VIGIL_SETTLE_BASE_DIR=%h/.sigil/credit-lease
