-        _vigil_degrade(PROOF_SUBSYSTEM_UNAVAILABLE, "strix.cli.install_from_env", _proof_exc)
+            _vigil_degrade(PROOF_SUBSYSTEM_UNAVAILABLE, "strix.cli.install_from_env", _proof_exc)
