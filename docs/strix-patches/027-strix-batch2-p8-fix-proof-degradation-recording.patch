+++ b/vendor/strix/strix/interface/cli.py
@@ -145,10 +145,13 @@ async def run_cli(args: Any) -> None:  # noqa: PLR0915
         # inv 12 (S9): a VIGIL run (VIGIL_PROOF_RUN_DIR set) expected proofs but the proof-sink
