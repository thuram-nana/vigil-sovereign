  "decode_vectors": [
    {"label": "iso-8859-1", "codec": "cp1252", "bytes_hex": "93949780",
     "expect_text": "“”—€",
     "why": "WHATWG maps the latin1 family to windows-1252: 0x80-0x9F are typographic characters (left/right curly quote, em dash, euro), NOT the C1 controls Python's iso-8859-1 codec produces. Reading this the browser's way is the whole point of resolving through the WHATWG table."},
    {"label": "latin1", "codec": "cp1252", "bytes_hex": "93",
     "expect_text": "“",
     "why": "same remap under the bare 'latin1' label."},
    {"label": "iso-8859-9", "codec": "cp1254", "bytes_hex": "dd",
     "expect_text": "İ",
     "why": "iso-8859-9 resolves to windows-1254 where 0xDD is LATIN CAPITAL I WITH DOT ABOVE (Turkish), a security-relevant remap."},
    {"label": "iso-8859-11", "codec": "cp874", "bytes_hex": "a1",
     "expect_text": "ก",
     "why": "iso-8859-11/tis-620 resolves to windows-874; 0xA1 is THAI CHARACTER KO KAI."},
    {"label": "euc-kr", "codec": "cp949", "bytes_hex": "b0a1",
     "expect_text": "가",
     "why": "euc-kr resolves to cp949/UHC; 0xB0A1 is the Hangul syllable GA."},
    {"label": "utf-16", "codec": "utf-16-le",
     "bytes_hex": "2f002f006500760069006c002f00",
     "expect_text": "//evil/",
     "why": "the bare 'utf-16' label is FIXED to UTF-16LE by WHATWG; Python's own utf-16 codec (no BOM) uses host byte order, which would flip the verdict across machines."}
  ]
