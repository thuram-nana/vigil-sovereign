__pycache__/
*.pyc
.venv/
venv/
.claude/
/scratch-demo/
.coverage
# W2-4 (#421): per-package coverage reports pytest-cov writes at the repo root in CI (ephemeral).
/coverage-*.xml
/coverage-*.json
*.egg-info/
dist/
build/
target/

# the two isolated environments (built by envs/build_envs.sh / bootstrap.sh)
.venv-sovereign/
.venv-offense/

# local runtime state + secrets — NEVER commit these
.env
.vigil-live/
.vigil-data/
.strix/

# stray local artifacts + operator reference images (kept on disk, never tracked)
/img.avif
/theme.png
/AEGIS-Detection-Mirror-Complete(1).md

# recall-baseline signing PRIVATE keys — the operator holds these out-of-band;
# ONLY the public authorizer (in the .sig.json) + fingerprint are committed.
*.privkey

# session working artifacts — never part of a commit
/scratchpad/
/conftest_probe.py
/benchmark-report.md

# compiled egress guard (built by `make -C tools/egress-guard`, never committed)
/tools/egress-guard/egress_guard

# security-scan.yml writes these scanner reports at the repo root during CI (uploaded as artifacts).
/gitleaks-tree.sarif
/gitleaks-history.sarif
/semgrep.sarif

# transient live-range / demo-run state — runtime DBs (meridian.sqlite3), pids, logs; never committed
/range/.target-live/
/engine/crucible/targets/acme/
/engine/crucible/targets/loopback/

# Runtime state a CLI run leaves in its base dir (default: the current directory). A test that forgot
# to redirect it once wrote these into the checkout and a blanket `git add` committed them. The test is
# fixed (integration/tests/test_plan_only.py); this is the backstop. Root-anchored on purpose.
/operator.key
/offense-governance.key
/offense-spine.key
/usage-ledger.jsonl
/*.spine
