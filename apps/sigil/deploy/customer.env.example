# SIGIL customer-edge systemd EnvironmentFile — copy to ~/.sigil/customer.env and edit.
# ==============================================================================
#   cp deploy/customer.env.example ~/.sigil/customer.env
#   chmod 600 ~/.sigil/customer.env
#
# Consumed by sigil-customer.service (EnvironmentFile=). Plain KEY=VALUE, one per
# line, NO quoting, NO `export`.

# --- data root (defaults to ~/.sigil; only set to relocate the spine + the
#     customer session ledger) --------------------------------------------------
# SIGIL_HOME=/home/youruser/.sigil

# --- customer edge bind: loopback (default) or a PRIVATE WireGuard/Tailscale IP.
#     NEVER 0.0.0.0 / a public address — `sigil serve-customer` fails closed
#     (exit 2). Front it with deploy/reverse-proxy/vigil-customer.* for a domain. -
VIGIL_CUSTOMER_BIND=127.0.0.1
VIGIL_CUSTOMER_PORT=8734

# --- reverse-proxy domain allowlist (anti-DNS-rebinding + CSRF). The edge SETS A
#     COOKIE, so it MUST know the public host/origin you front it with, or every
#     POST (signup/login/member/target/launch) fails closed. Comma-separated; the
#     CLI --allow-host/--allow-origin flags union with these. ---------------------
# VIGIL_CUSTOMER_ALLOWED_HOSTS=app.vigilguard.net
# VIGIL_CUSTOMER_ALLOWED_ORIGINS=https://app.vigilguard.net

# --- provisioner hop key (REQUIRED for a working app). The keyless edge reaches
#     the sovereign provisioner over loopback authenticated by THIS shared secret;
#     an empty/unset key fails every provisioning route CLOSED (signup/login/
#     recover). Must match the provisioner's VIGIL_PROVISION_HOP_KEY. Generate a
#     high-entropy value (e.g. `openssl rand -hex 32`) and keep this file 0600. ---
# VIGIL_PROVISION_HOP_KEY=change-me-to-a-32-byte-random-hex

# --- iOS install guide: show iPhone/iPad visitors in the browser a dismissible
#     "Share -> Add to Home Screen" guide and put the iOS home-screen tags in the
#     page (Android/desktop Chromium get an "Install app" button regardless). It
#     hides once the app runs from the Home Screen and remembers a dismissal.
#     Google sign-in inside the installed app needs VIGIL_CUSTOMER_OIDC_HANDOFF
#     below. Read when the edge starts. ------------------------------------------
# owner-set: the guide is on in production
VIGIL_CUSTOMER_IOS_INSTALL_BANNER=1

# --- customer sign-in with Google. The cockpit's provisioner reads the same
#     switch, client id and redirect URI: set them to the SAME values in
#     ~/.sigil/cockpit.env (`vigil doctor` reports a difference). The client
#     SECRET goes in cockpit.env only — never in this file. Read when the edge
#     starts (the "Continue with Google" button is written into the page). -------
# owner-set: "Continue with Google" on the sign-in and sign-up screens
VIGIL_CUSTOMER_OIDC_ENABLED=1
# the OAuth web client id from Google Cloud (not a secret) and the redirect URI
# registered with it, exactly
# VIGIL_CUSTOMER_OIDC_CLIENT_ID=<client-id>.apps.googleusercontent.com
# VIGIL_CUSTOMER_OIDC_REDIRECT_URI=https://app.vigilguard.net/api/customer/oidc/callback
# owner-set: Google sign-in finishes INSIDE the installed iPhone app — the page
# where Google sign-in finished shows a 6-digit code the person types into the
# app (read by this edge only). Every step must come from one network (IPv4 /24,
# IPv6 /56): a code redeemed from anywhere else signs in nobody (GO-LIVE §7b).
VIGIL_CUSTOMER_OIDC_HANDOFF=1

# --- buying: the SAME checkout and plan switches as ~/.sigil/cockpit.env (owner launch pricing, 2026-11-24).
#     The edge reads them to draw the buy buttons, the Plans screen and plan changes. No secret here. ------------
# owner-set: the go-live switch for hosted checkout — turn it on together with the cockpit's, once the Stripe
# drain is running and a real purchase has been credited end to end
# VIGIL_CUSTOMER_CHECKOUT_ENABLED=1
# owner-set: the monthly credit plans (Starter / Pro / Team) on the Plans screen, changeable at the next renewal
VIGIL_CUSTOMER_PLANS=1
VIGIL_CUSTOMER_PLAN_CHANGE=1

# --- settling: the customer edge's cancel settles a launch ---------------------
# owner-set: the settle record on the spine — the SAME value as the cockpit and
# the settle drain (`vigil doctor` reports a difference)
VIGIL_SETTLE_SPINE_RECORD=1

# --- proof badge: "Independently verifiable" on each finding + its proof
#     bundle download (OFF unless set). The SAME value as the cockpit, which
#     also needs the delegation path (see cockpit.env). Read when the edge
#     starts (the switch is written into the page). --------------------------------
# owner-set: the proof badge is ON; it shows a badge only when the cockpit sets the SAME switch AND the
# delegation path (VIGIL_CUSTOMER_PROOF_DELEGATIONS in cockpit.env) — until then it badges nothing (fail-safe)
VIGIL_CUSTOMER_PROOF_BADGE=1

# ==============================================================================
# === FULL CONSUMER FEATURE SET — on for production ============================
#   Every consumer-facing screen/capability the product ships (the "A-list" of the
#   2026-11-27 default-OFF audit). Each renders/behaves only when the server also
#   reports it available; with the flag off the page is byte-identical. Features
#   needing an owner secret/path fail SAFE (show nothing / refuse) until you fill
#   the placeholder — none block the app. Set the SAME values in ~/.sigil/cockpit.env
#   (parity; `vigil doctor` reports a difference). Deliberately NOT here (gated —
#   see the audit's gated list + GO-LIVE): hosted checkout (money-in), live prod
#   execution (VIGIL_CUSTOMER_PROD_EXECUTION), and all AEGIS/APEX enforcement gates.
# ------------------------------------------------------------------------------
# consumer UI / disclosure screens (pure read/preference; mint nothing, move no money)
VIGIL_CUSTOMER_OVERVIEW=1
VIGIL_CUSTOMER_BILLING_DASHBOARD=1
VIGIL_CUSTOMER_SETTINGS=1
VIGIL_CUSTOMER_AUTHORIZATIONS=1
VIGIL_CUSTOMER_PRIVACY_CENTER=1
VIGIL_CUSTOMER_DATA_RIGHTS=1
VIGIL_CUSTOMER_AI_GOVERNANCE=1
VIGIL_CUSTOMER_SELLER_IDENTITY=1
# findings presentation (read-only projections of already-signed findings)
VIGIL_APEX_PRESENTATION=1
VIGIL_CUSTOMER_POSTURE=1
VIGIL_CUSTOMER_ATTACK_PATH=1
VIGIL_CUSTOMER_BLIND_VULN=1
# reports & compliance (HTML report is script-free; the PDF leg fails closed without the owner renderer)
VIGIL_CUSTOMER_PDF_REPORT=1
# VIGIL_REPORT_PDF_RENDERER=/path/to/owner-pinned-renderer
VIGIL_CUSTOMER_COMPLIANCE_MAP=1
# account security & sign-in (passkeys / SSO fail closed until their config below is set)
VIGIL_CUSTOMER_SECURITY_UI=1
VIGIL_CUSTOMER_MFA_ENROLL_STEPUP=1
VIGIL_CUSTOMER_PASSKEY_ENABLED=1
# VIGIL_CUSTOMER_PASSKEY_RP_ID=app.vigilguard.net
# VIGIL_CUSTOMER_PASSKEY_ORIGINS=https://app.vigilguard.net
VIGIL_CUSTOMER_SSO=1
#   SSO also needs an owner-signed per-org governor sso_config; SAML needs a vetted XML-DSig backend
# assessment control & connect (surface only — a LIVE run still rides VIGIL_CUSTOMER_PROD_EXECUTION + host proof)
VIGIL_CUSTOMER_LAUNCH_UI=1
VIGIL_CUSTOMER_RETEST_UI=1
VIGIL_CUSTOMER_LIVE_CONTROL=1
VIGIL_CUSTOMER_PAUSE_RESUME_ENABLED=1
VIGIL_CUSTOMER_TEAM_UI=1
# team email invitations (invite a person who has no VIGIL account yet). DEFAULT ON; set here explicitly for launch.
# An invite is role-capped, single-use + 7-day expiring, tenant-scoped and rate-limited, and grants nothing until it
# is accepted at sign-up / sign-in. The invite email only leaves the box once SMTP is configured (SIGIL_EMAIL_* in
# cockpit.env); until then an invite is recorded but no mail is sent. Set VIGIL_CUSTOMER_TEAM_INVITE=0 to disable.
VIGIL_CUSTOMER_TEAM_INVITE=1
VIGIL_CUSTOMER_CONNECT=1
VIGIL_CUSTOMER_CLOUD_CONNECT=1
#   Cloudflare connects with no operator credential; AWS/GCP/Azure need VIGIL's read-only connector identity (cockpit.env)
VIGIL_OWNERSHIP_VERIFY=1
# security assistant + notifications + Red-Pen code review
VIGIL_CUSTOMER_ASSISTANT=1
VIGIL_CUSTOMER_ASSISTANT_WALLET=1
VIGIL_CUSTOMER_NOTIFY=1
VIGIL_REDPEN_ENABLED=1
# growth
VIGIL_CUSTOMER_FAIR_QUEUE=1
# security hardening: DISABLE the fail-open legacy shared owner token (production posture forces this too)
SIGIL_LEGACY_OWNER_TOKEN=0
# ==============================================================================

# --- log verbosity: DEBUG | INFO | WARNING | ERROR --------------------------
SIGIL_LOG_LEVEL=INFO
