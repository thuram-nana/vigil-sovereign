# SIGIL customer-edge systemd EnvironmentFile — copy to ~/.sigil/customer.env and edit.
# ==============================================================================
#   cp deploy/customer.env.example ~/.sigil/customer.env
#   chmod 600 ~/.sigil/customer.env
#
# Consumed by sigil-customer.service (EnvironmentFile=). Plain KEY=VALUE, one per
# line, NO quoting, NO `export`.

# --- data root (defaults to ~/.sigil; only set to relocate the spine + the
#     customer session ledger) --------------------------------------------------
# SIGIL_HOME=/home/youruser/.sigil

# --- customer edge bind: loopback (default) or a PRIVATE WireGuard/Tailscale IP.
#     NEVER 0.0.0.0 / a public address — `sigil serve-customer` fails closed
#     (exit 2). Front it with deploy/reverse-proxy/vigil-customer.* for a domain. -
VIGIL_CUSTOMER_BIND=127.0.0.1
VIGIL_CUSTOMER_PORT=8734

# --- reverse-proxy domain allowlist (anti-DNS-rebinding + CSRF). The edge SETS A
#     COOKIE, so it MUST know the public host/origin you front it with, or every
#     POST (signup/login/member/target/launch) fails closed. Comma-separated; the
#     CLI --allow-host/--allow-origin flags union with these. ---------------------
# VIGIL_CUSTOMER_ALLOWED_HOSTS=app.example.com
# VIGIL_CUSTOMER_ALLOWED_ORIGINS=https://app.example.com

# --- provisioner hop key (REQUIRED for a working app). The keyless edge reaches
#     the sovereign provisioner over loopback authenticated by THIS shared secret;
#     an empty/unset key fails every provisioning route CLOSED (signup/login/
#     recover). Must match the provisioner's VIGIL_PROVISION_HOP_KEY. Generate a
#     high-entropy value (e.g. `openssl rand -hex 32`) and keep this file 0600. ---
# VIGIL_PROVISION_HOP_KEY=change-me-to-a-32-byte-random-hex

# --- log verbosity: DEBUG | INFO | WARNING | ERROR --------------------------
SIGIL_LOG_LEVEL=INFO
