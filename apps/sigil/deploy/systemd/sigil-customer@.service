# SIGIL customer edge (custui) — systemd USER service TEMPLATE: one edge per loopback port
# =============================================================================
# The instance name IS the port: sigil-customer@8734 and sigil-customer@8744 are
# the two halves of the edge swap (tools/deploy/edge-swap.sh). The nginx vhost
# (deploy/reverse-proxy/vigil-customer.nginx.conf) sends every request to 8734
# while it accepts connections and to 8744 when it does not, so a new edge can
# start on the free port, prove /healthz, and only then replace the old one.
# The swap goes out to 8744 and back, so the edge rests on @8734.
#
# Everything else is sigil-customer.service: the same env file (bind address,
# allowlist, provisioner hop key), the same graceful SIGTERM drain, the same
# hardening. Run EITHER the plain sigil-customer.service OR these instances —
# never the plain unit and @8734 together (they want the same port). The swap
# script moves you from the plain unit to an instance the first time it runs.
#
# INSTALL (user-level, no root):
#   cp deploy/systemd/sigil-customer@.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   export VIGIL_EDGE_SWAP_CUSTOMER_URL=https://app.vigilguard.net   # where the proxy serves it
#   tools/deploy/edge-swap.sh customer      # replaces whichever customer edge runs now
#
# Logs → the journal:  journalctl --user -u 'sigil-customer@*' -f

[Unit]
Description=SIGIL customer edge (custui) on loopback port %i
Documentation=file:%h/sigil/RUNBOOK.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.sigil/customer.env
Environment=SIGIL_LOG_LEVEL=INFO
WorkingDirectory=%h/.sigil
ExecStart=%h/.sigil/venv/bin/sigil serve-customer --host ${VIGIL_CUSTOMER_BIND} --port %i

# --- lifecycle -------------------------------------------------------------
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
# A stopping edge first finishes every request it accepted, up to 75 s (custui.drain_deadline_s: past its
# slowest wait on the cockpit, 60 s for a sign-up email), so a stop never cuts an action the cockpit is
# still completing. systemd must not SIGKILL before that (a test pins the margin).
TimeoutStopSec=90

# --- hardening (as sigil-customer.service) -----------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=%h/.sigil
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=default.target
