# SIGIL cockpit systemd EnvironmentFile — copy to ~/.sigil/cockpit.env and edit.
# ==============================================================================
#   cp deploy/cockpit.env.example ~/.sigil/cockpit.env
#   chmod 600 ~/.sigil/cockpit.env
#
# Consumed by sigil-cockpit.service (EnvironmentFile=). Plain KEY=VALUE, one per
# line, NO quoting, NO `export`. Anything set here also overrides SIGIL defaults.

# --- data root (defaults to ~/.sigil; only set to relocate the spine) -------
# SIGIL_HOME=/home/youruser/.sigil

# --- cockpit bind: loopback (default) or a PRIVATE WireGuard/Tailscale IP.
#     NEVER 0.0.0.0 / a public address — `sigil serve` fails closed (exit 2). --
SIGIL_UI_BIND=127.0.0.1
SIGIL_UI_PORT=8733

# --- reverse-proxy domain allowlist (anti-DNS-rebinding). Set these to the
#     domain you front the cockpit with via deploy/reverse-proxy/. Comma-
#     separated; the CLI --allow-host/--allow-origin flags union with these. ---
# SIGIL_UI_ALLOWED_HOSTS=console.vigilguard.net
# SIGIL_UI_ALLOWED_ORIGINS=https://console.vigilguard.net

# --- free trial and sign-up limits (read by the customer provisioner, which
#     runs in this cockpit process) ------------------------------------------
# owner-set: the free trial with partial results until the org buys credits
VIGIL_TRIAL_PREVIEW_ENABLED=1
# owner-set: offer the Quick and Deep launch products (the trial runs Quick)
VIGIL_TIERED_PRODUCTS=1
# owner-set: credits granted with a new trial
VIGIL_TRIAL_CREDITS=300
# owner-set: the one launch product a trial org may run, the Quick scan (on
# offer while VIGIL_TIERED_PRODUCTS is on)
VIGIL_TRIAL_PRODUCT_ID=vigil_launch_quick
# owner-set: trial launches per rolling 24h, all trial orgs together
VIGIL_TRIAL_LAUNCH_DAILY_CAP=1000
# owner-set: committed self-serve sign-ups per rolling 24h
VIGIL_SIGNUP_DAILY_CAP=1000
# owner-set: sign-up requests per mailbox per hour
VIGIL_SIGNUP_EMAIL_PER_HOUR=5
# owner-set: the per-IP trial-grant limit stays OFF on purpose (people who
# share an office connection share one IP); leave it unset
# VIGIL_TRIAL_IP_LIMIT_ENABLED=

# --- launches ----------------------------------------------------------------
# owner-set: one outstanding launch per (org, host). Read by this process's
# launch reserve and start paths; the settle drain does not read it.
VIGIL_ONE_LAUNCH_PER_HOST=1
# Settle record on the spine: owner decision pending. When it is set, set the
# SAME value in the settle drain's env (vigil-settle-drain.env.example).
# VIGIL_SETTLE_SPINE_RECORD=1

# --- log verbosity: DEBUG | INFO | WARNING | ERROR --------------------------
SIGIL_LOG_LEVEL=INFO
