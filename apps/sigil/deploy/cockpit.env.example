# SIGIL cockpit systemd EnvironmentFile — copy to ~/.sigil/cockpit.env and edit.
# ==============================================================================
#   cp deploy/cockpit.env.example ~/.sigil/cockpit.env
#   chmod 600 ~/.sigil/cockpit.env
#
# Consumed by sigil-cockpit.service (EnvironmentFile=). Plain KEY=VALUE, one per
# line, NO quoting, NO `export`. Anything set here also overrides SIGIL defaults.

# --- data root (defaults to ~/.sigil; only set to relocate the spine) -------
# SIGIL_HOME=/home/youruser/.sigil

# --- cross-plane money seam base (leases, authorizations, pause/settlement markers). The unit ships
#     VIGIL_BASE_DIR=%h/.sigil/credit-lease; override ONLY with an ABSOLUTE path (no %h here — systemd does
#     not expand it in this file) and set the SAME value for every unit that shares the seam (settle drain,
#     offense backup, the offense side). `vigil doctor` refuses when they disagree. -----------------------
# VIGIL_BASE_DIR=/home/youruser/.sigil/credit-lease
#     The unit also sets VIGIL_SEAM_MIGRATION_GUARD=1 (production value): the cockpit refuses to start while a
#     former seam directory (e.g. ~/.sigil/.vigil-live) holds launch-seam records not yet carried into the seam —
#     run `sigil seam migrate`, then `sigil seam migrate --apply`, with the cockpit and the settle drain stopped.
#     Override it here (VIGIL_SEAM_MIGRATION_GUARD=0) only deliberately. A guarded `sigil` verb run from a shell
#     that does not export it (ops-sweep reservations --apply, eval-grant arm, monitoring-secret) follows the
#     units: it is on while any configured seam unit sets it.

# --- cockpit bind: loopback (default) or a PRIVATE WireGuard/Tailscale IP.
#     NEVER 0.0.0.0 / a public address — `sigil serve` fails closed (exit 2). --
SIGIL_UI_BIND=127.0.0.1
SIGIL_UI_PORT=8733

# --- reverse-proxy domain allowlist (anti-DNS-rebinding). Set these to the
#     domain you front the cockpit with via deploy/reverse-proxy/. Comma-
#     separated; the CLI --allow-host/--allow-origin flags union with these. ---
# SIGIL_UI_ALLOWED_HOSTS=console.vigilguard.net
# SIGIL_UI_ALLOWED_ORIGINS=https://console.vigilguard.net

# --- free trial and sign-up limits (read by the customer provisioner, which
#     runs in this cockpit process) ------------------------------------------
# owner-set: the free trial with partial results until the org buys credits
VIGIL_TRIAL_PREVIEW_ENABLED=1
# owner-set: offer the Quick and Deep launch products (the trial runs Quick)
VIGIL_TIERED_PRODUCTS=1
# owner-set: credits granted with a new trial (decided: 450, one per verified email and per verified domain)
VIGIL_TRIAL_CREDITS=450
# --- what customers can buy (owner launch pricing, 2026-11-24; prices live in governor/catalog.py) ----------------
#     Credit packs: $5 / $10 / $16 / $25 / $50 / $100 = 500 ... 10,000 credits (never expire).
#     Monthly plans: Starter $29 / 3,200, Pro $99 / 12,000, Team $299 / 39,000 credits a month; plan credits are
#     spent first and expire at the end of each month, then purchased credits are used. A cancelled plan runs to the
#     end of the month already paid. Set the SAME checkout and plan switches in customer.env (the customer edge
#     draws the Plans screen and the buy buttons from them).
# owner-set: the go-live switch for ALL hosted checkout (packs and plans). Turn it on ONLY once the Stripe drain
# is running and a real purchase has been credited end to end (GO-LIVE §9b step 5). Until then nothing can be bought.
# VIGIL_CUSTOMER_CHECKOUT_ENABLED=1
# The checkout itself is created here, by the provisioner, so it needs the Stripe lane too (the same values as the
# Stripe drain's env, GO-LIVE §9b; secrets from your secret manager, never in git):
# VIGIL_BILLING_ENABLE_STRIPE=1
# VIGIL_STRIPE_SECRET_KEY=
# VIGIL_STRIPE_WEBHOOK_SECRET=
# VIGIL_STRIPE_API_VERSION=
# where Stripe sends the customer after paying (an absolute https URL on the customer app)
# VIGIL_CUSTOMER_BILLING_RETURN_URL=https://app.vigilguard.net/#/billing
# owner-set: the monthly credit plans are sold (with checkout on), shown on the Plans screen, and can be changed or
# cancelled self-serve at the next renewal
VIGIL_CUSTOMER_PLAN_CHECKOUT_ENABLED=1
VIGIL_CUSTOMER_PLANS=1
VIGIL_CUSTOMER_PLAN_CHANGE=1
# owner-set: the one launch product a trial org may run, the Quick scan (on
# offer while VIGIL_TIERED_PRODUCTS is on)
VIGIL_TRIAL_PRODUCT_ID=vigil_launch_quick
# owner-set: trial launches per rolling 24h, all trial orgs together
VIGIL_TRIAL_LAUNCH_DAILY_CAP=1000
# owner-set: committed self-serve sign-ups per rolling 24h
VIGIL_SIGNUP_DAILY_CAP=1000
# owner-set: sign-up requests per mailbox per hour
VIGIL_SIGNUP_EMAIL_PER_HOUR=5
# owner-set: the per-IP trial-grant limit stays OFF on purpose (people who
# share an office connection share one IP); leave it unset
# VIGIL_TRIAL_IP_LIMIT_ENABLED=

# --- customer roles (read by the customer provisioner in this process) ------
# owner-set: a sign-up makes its founding customer a `founder` (org admin plus
# self-serve scans on hosts the org proves it controls; every launch gate still
# applies). Needs VIGIL_TRIAL_PREVIEW_ENABLED=1 above: with the preview off, a
# sign-up grants org_admin.
# Kill switch: set it to 0 here and run `systemctl --user restart sigil-cockpit`
# (systemd reads this file only when the cockpit starts). Existing founders are
# then admitted as org admins (no testing) until it is 1 again and the cockpit
# restarted. Keep this flag out of ~/.sigil/sigil.env.
# Before rolling back to a build without the founder role: set it to 0, restart
# sigil-cockpit, then run `sigil org demote-founders --reason rollback`.
# Step-up is not required for founders (owner decision): leave
# VIGIL_CUSTOMER_STEPUP_REQUIRED unset.
VIGIL_SIGNUP_FOUNDER_TESTER_ENABLED=1
# --- customer sign-in: Google and email (read by the customer provisioner in
#     this process). The customer edge reads the Google switch, client id and
#     redirect URI too: set them to the SAME values in ~/.sigil/customer.env
#     (`vigil doctor` reports a difference). Secrets go in this file only (or
#     your secret manager), never in customer.env and never in git. -------------
# owner-set: customers may sign in with Google
VIGIL_CUSTOMER_OIDC_ENABLED=1
# VIGIL_CUSTOMER_OIDC_CLIENT_ID=<client-id>.apps.googleusercontent.com
# VIGIL_CUSTOMER_OIDC_REDIRECT_URI=https://app.vigilguard.net/api/customer/oidc/callback
# the OAuth client secret (secret: this process only)
# VIGIL_CUSTOMER_OIDC_CLIENT_SECRET=
# owner-set: the sign-up and password-reset emails also carry a 6-digit code to
# type into the app (single use, 10 minutes); the token in the email still works
VIGIL_CUSTOMER_EMAIL_CODE=1
# outgoing email: SMTP with STARTTLS (port 587). Unset SIGIL_EMAIL_HOST = no
# email is sent at all, so nobody can confirm a sign-up or reset a password.
# SIGIL_EMAIL_HOST=email-smtp.<region>.amazonaws.com
# SIGIL_EMAIL_PORT=587
# SIGIL_EMAIL_FROM=no-reply@vigilguard.net
# SIGIL_EMAIL_USER=
# the SMTP password (secret: this process only)
# SIGIL_EMAIL_PASSWORD=

# --- launches ----------------------------------------------------------------
# owner-set: one outstanding launch per (org, host). Read by this process's
# launch reserve and start paths; the settle drain does not read it.
VIGIL_ONE_LAUNCH_PER_HOST=1
# Each prepaid launch lease records the plan/wallet split of its reservation
# under the owner signature, so its settle refunds each bucket correctly even
# after a hard prune of the spine. Read by this process's launch reserve. Both
# planes must run the same release: an older offense build refuses a lease
# that carries the split (the launch does not run and is refunded).
VIGIL_LEASE_PLAN_SPLIT=1
# owner-set: every settle is recorded on the spine first, so a settle a crash or
# a stop interrupts is finished from that record. Set the SAME value in
# customer.env, the settle drain's env and the shell that runs `sigil
# ops-sweep` (or once in $SIGIL_HOME/sigil.env): `vigil doctor` reports a
# difference.
VIGIL_SETTLE_SPINE_RECORD=1

# --- proof badge: "Independently verifiable" + the per-finding proof bundle
#     (read by the customer provisioner in this process; OFF unless set). Set
#     the switch to the SAME value in customer.env (the edge serves the download
#     and draws the badge); with only one of the two on, no badge is shown. -----
# owner-set: proof badge ON (matches customer.env); it badges a finding only once the delegation path below is set
VIGIL_CUSTOMER_PROOF_BADGE=1
# The owner-signed offense-governance delegation(s) the badge verifies findings
# under: normally the SAME file as the finding drain's
# VIGIL_FINDING_GOV_DELEGATION, plus the previous one(s) during a governance-key
# rotation. ABSOLUTE paths separated by ':'. Each is re-checked against the
# owner key, its scope and the clock on every read: an expired one badges
# nothing (renew it to keep old findings badged). Unset = no finding is badged.
# VIGIL_CUSTOMER_PROOF_DELEGATIONS=/home/youruser/.config/vigil/offense-governance-delegation.json
# The governance fingerprint(s) VIGIL publishes for auditors (sha256:<hex>,
# comma separated). Set, a proof is offered only under a published root. Give
# the public site (~/.sigil/public.env) the same value and the switch above: its
# /verify page prints these fingerprints for auditors to pin.
# VIGIL_PROOF_PUBLISHED_FINGERPRINTS=sha256:<64 hex>

# --- checkout terms acceptance (read by the provisioner in this process) -----
# owner-set: every Stripe checkout requires the customer to tick a Terms of Service box before paying. Its text is
# VIGIL's and replaces Stripe's default agreement text: "I agree to the VIGIL Terms of Service" with a link to
# https://vigilguard.net/terms, plus the immediate-supply wording consumers need (Terms §8). Set the Terms of Service
# URL in the Stripe dashboard first (Settings -> Business -> Public details: https://vigilguard.net/terms): Stripe
# refuses the box without it.
VIGIL_STRIPE_TERMS_CONSENT=1

# --- refunds, chargebacks and withdrawals (W5; read by `sigil billing-reversal`) ----
# owner-set: lets `sigil billing-reversal` remove the credits of a refunded pack or plan (a consumer's withdrawal,
# docs/runbooks/consumer-withdrawal.md) and show the orgs on a billing hold. Set the SAME value in the Stripe drain's
# env (billing-drain-stripe.env), which acts on Stripe's refund and dispute events. Default OFF: every
# `billing-reversal` verb refuses and the drain ignores those events.
# VIGIL_BILLING_REVERSALS=1

# ==============================================================================
# === FULL CONSUMER FEATURE SET — on for production (parity with customer.env) =
#   The SAME consumer feature flags as ~/.sigil/customer.env, set here too so the
#   cockpit provisioner and `vigil doctor` agree (a plane that does not read a flag
#   simply ignores it). Features needing an owner secret/path fail SAFE until the
#   placeholder is filled. Owner SECRETS (OIDC/SSO/cloud-connector/passkey) live in
#   THIS file only, never in customer.env or git. Deliberately NOT on (gated — see
#   the audit's gated list + GO-LIVE): hosted checkout (money-in), live prod
#   execution (VIGIL_CUSTOMER_PROD_EXECUTION), and all AEGIS/APEX enforcement gates.
# ------------------------------------------------------------------------------
VIGIL_CUSTOMER_OVERVIEW=1
VIGIL_CUSTOMER_BILLING_DASHBOARD=1
VIGIL_CUSTOMER_SETTINGS=1
VIGIL_CUSTOMER_AUTHORIZATIONS=1
VIGIL_CUSTOMER_PRIVACY_CENTER=1
VIGIL_CUSTOMER_DATA_RIGHTS=1
VIGIL_CUSTOMER_AI_GOVERNANCE=1
VIGIL_CUSTOMER_SELLER_IDENTITY=1
VIGIL_APEX_PRESENTATION=1
VIGIL_CUSTOMER_POSTURE=1
VIGIL_CUSTOMER_ATTACK_PATH=1
VIGIL_CUSTOMER_BLIND_VULN=1
VIGIL_CUSTOMER_PDF_REPORT=1
# VIGIL_REPORT_PDF_RENDERER=/path/to/owner-pinned-renderer
VIGIL_CUSTOMER_COMPLIANCE_MAP=1
VIGIL_CUSTOMER_SECURITY_UI=1
VIGIL_CUSTOMER_MFA_ENROLL_STEPUP=1
VIGIL_CUSTOMER_PASSKEY_ENABLED=1
# VIGIL_CUSTOMER_PASSKEY_RP_ID=app.vigilguard.net
# VIGIL_CUSTOMER_PASSKEY_ORIGINS=https://app.vigilguard.net
VIGIL_CUSTOMER_SSO=1
#   SSO: provision an owner-signed per-org governor sso_config; SAML needs a vetted XML-DSig backend
VIGIL_CUSTOMER_LAUNCH_UI=1
VIGIL_CUSTOMER_RETEST_UI=1
VIGIL_CUSTOMER_LIVE_CONTROL=1
VIGIL_CUSTOMER_PAUSE_RESUME_ENABLED=1
VIGIL_CUSTOMER_TEAM_UI=1
# team email invitations (the cockpit re-checks the SAME flag the edge gates on; keep both sides equal). DEFAULT ON;
# set here explicitly for launch. Role-capped, single-use + 7-day expiring, tenant-scoped, rate-limited; grants nothing
# until accepted. The invite email sends only once SMTP is configured below (SIGIL_EMAIL_*). Set to 0 to disable.
VIGIL_CUSTOMER_TEAM_INVITE=1
VIGIL_CUSTOMER_CONNECT=1
VIGIL_CUSTOMER_CLOUD_CONNECT=1
#   cloud connector identities (owner-provisioned, read-only; secrets THIS file only):
#   AWS:  VIGIL_CLOUD_CONNECT_AWS_PRINCIPAL_ARN= / AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=
#   GCP:  VIGIL_CLOUD_CONNECT_GCP_CONNECTOR_SA= / GCP_PRIVATE_KEY=
#   Azure: VIGIL_CLOUD_CONNECT_AZURE_CLIENT_ID= / AZURE_CLIENT_SECRET=
#   Cloudflare needs none.
VIGIL_OWNERSHIP_VERIFY=1
VIGIL_CUSTOMER_ASSISTANT=1
VIGIL_CUSTOMER_ASSISTANT_WALLET=1
VIGIL_CUSTOMER_NOTIFY=1
VIGIL_REDPEN_ENABLED=1
VIGIL_CUSTOMER_FAIR_QUEUE=1
# the owner-signed delegation(s) the proof badge verifies findings under (absolute paths, ':'-separated);
# unset = the badge shows nothing (fail-safe). See the proof-badge block above.
# VIGIL_CUSTOMER_PROOF_DELEGATIONS=/home/youruser/.config/vigil/offense-governance-delegation.json
# security hardening: DISABLE the fail-open legacy shared owner token (production posture forces this too)
SIGIL_LEGACY_OWNER_TOKEN=0
# ==============================================================================

# --- log verbosity: DEBUG | INFO | WARNING | ERROR --------------------------
SIGIL_LOG_LEVEL=INFO
