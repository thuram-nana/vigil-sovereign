# SIGIL cockpit systemd EnvironmentFile — copy to ~/.sigil/cockpit.env and edit.
# ==============================================================================
#   cp deploy/cockpit.env.example ~/.sigil/cockpit.env
#   chmod 600 ~/.sigil/cockpit.env
#
# Consumed by sigil-cockpit.service (EnvironmentFile=). Plain KEY=VALUE, one per
# line, NO quoting, NO `export`. Anything set here also overrides SIGIL defaults.

# --- data root (defaults to ~/.sigil; only set to relocate the spine) -------
# SIGIL_HOME=/home/youruser/.sigil

# --- cross-plane money seam base (leases, authorizations, pause/settlement markers). The unit ships
#     VIGIL_BASE_DIR=%h/.sigil/credit-lease; override ONLY with an ABSOLUTE path (no %h here — systemd does
#     not expand it in this file) and set the SAME value for every unit that shares the seam (settle drain,
#     offense backup, the offense side). `vigil doctor` refuses when they disagree. -----------------------
# VIGIL_BASE_DIR=/home/youruser/.sigil/credit-lease

# --- cockpit bind: loopback (default) or a PRIVATE WireGuard/Tailscale IP.
#     NEVER 0.0.0.0 / a public address — `sigil serve` fails closed (exit 2). --
SIGIL_UI_BIND=127.0.0.1
SIGIL_UI_PORT=8733

# --- reverse-proxy domain allowlist (anti-DNS-rebinding). Set these to the
#     domain you front the cockpit with via deploy/reverse-proxy/. Comma-
#     separated; the CLI --allow-host/--allow-origin flags union with these. ---
# SIGIL_UI_ALLOWED_HOSTS=console.vigilguard.net
# SIGIL_UI_ALLOWED_ORIGINS=https://console.vigilguard.net

# --- log verbosity: DEBUG | INFO | WARNING | ERROR --------------------------
SIGIL_LOG_LEVEL=INFO
