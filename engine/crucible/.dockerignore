# Keep the AEGIS gateway build context lean. This dir (engine/crucible) IS the AEGIS build
# context (docker-compose.yml sets `context: ./engine/crucible`; the shared vigil_core substrate
# comes in as a separate named build context). Only applies to docker builds whose context is
# this dir; the corpus-fixture Dockerfiles use their own local contexts.
.git
.gitignore
graphify-out/
**/__pycache__/
**/*.pyc
**/*.pyo
.pytest_cache/
.mypy_cache/
dist/
build/
sdist/
wheels/
*.egg-info/
.eggs/
.venv/
venv/
env/
node_modules/
# Engagement data + local operator state (never belongs in a shipped image).
targets/
# Stray root artifacts not needed to build the package.
*.html
benchmark-report.md
