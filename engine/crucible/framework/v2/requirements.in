# CRUCIBLE v2 — runtime dependencies (source spec for pip-compile).
#
# This file is the INPUT to pip-compile. The hash-pinned, fully-
# resolved output lives at requirements.lock.txt. Sovereign
# deployments install from the lock file; development can install
# from this file directly.
#
# Regenerate the lock with (Python 3.13 — the lock is Python-minor
# specific; --no-header keeps the output byte-comparable):
#   pip install pip-tools==7.6.1
#   pip-compile --generate-hashes --no-header --strip-extras \
#               --output-file=framework/v2/requirements.lock.txt \
#               framework/v2/requirements.in
#
# The verification script `bin/verify-supply-chain.sh` re-runs this
# command and exits non-zero on drift. It is run by the "A14
# supply-chain gate" CI job (.github/workflows/supply-chain.yml).
#
# Optional extras (pick what you actually use, then add to a separate
# requirements file — never expand this base spec without review):
#
#   anthropic                # cloud LLM backend; refused under
#                            # CRUCIBLE_SOVEREIGN_MODE=1
#   sentence-transformers    # higher-quality embeddings
#                            # (~80MB model on first use)
#
# v2 ships in DryRun mode by default — no network and no GPU required.
# See V2-LIMITATIONS.md for what dry-run sacrifices.

pydantic>=2.10,<3
structlog>=25.0,<26
httpx>=0.28,<1
requests>=2.32,<3
